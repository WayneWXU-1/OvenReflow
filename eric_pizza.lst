0601            324   
0601            325   Timer0_Init:
0601 E589       326            mov a, TMOD
0603 54F0       327            anl a, #0xf0 ; Clear the bits for timer 0
0605 4401       328            orl a, #0x01 ; Configure timer 0 as 16-timer
0607 F589       329            mov TMOD, a
0609 758CFD     330            mov TH0, #high(TIMER0_RELOAD)
060C 758A5A     331            mov TL0, #low(TIMER0_RELOAD)
060F            332            ; Enable the timer and interrupts
060F D2A9       333       setb ET0  ; Enable timer 0 interrupt
0611 D28C       334       setb TR0  ; Start timer 0
0613 22         335            ret
0614            336   
0614            337   ;---------------------------------;
0614            338   ; ISR for timer 0.  Set to execute;
0614            339   ; every 1/4096Hz to generate a    ;
0614            340   ; 2048 Hz square wave at pin P1.5 ;
0614            341   ;---------------------------------;
0614            342   Timer0_ISR:
0614            343            ;clr TF0  ; According to the data sheet this is done for us already.
0614 758CFD     344            mov TH0, #high(TIMER0_RELOAD) ; Timer 0 doesn't have autoreload in the CV-8052
0617 758A5A     345            mov TL0, #low(TIMER0_RELOAD)
061A B295       346            cpl SOUND_OUT ; Connect speaker to P1.5
061C 32         347            reti
061D            348   
061D            349   ;---------------------------------;
061D            350   ; Routine to initialize the ISR   ;
061D            351   ; for timer 2                     ;
061D            352   ;---------------------------------;
061D            353   Timer2_Init:
061D 75C800     354            mov T2CON, #0 ; Stop timer/counter.  Autoreload mode.
0620 75CDF5     355            mov TH2, #high(TIMER2_RELOAD)
0623 75CC27     356            mov TL2, #low(TIMER2_RELOAD)
0626            357            ; Set the reload value
0626 75CBF5     358            mov RCAP2H, #high(TIMER2_RELOAD)
0629 75CA27     359            mov RCAP2L, #low(TIMER2_RELOAD)
062C            360            ; Init One millisecond interrupt counter.  It is a 16-bit variable made with two 8-bit parts
062C E4         361            clr a
062D F575       362            mov Count1ms+0, a
062F F576       363            mov Count1ms+1, a
0631            364            ; Enable the timer and interrupts
0631 D2AD       365       setb ET2  ; Enable timer 2 interrupt
0633 D2CA       366       setb TR2  ; Enable timer 2
0635 22         367            ret
0636            368   
0636            369   ;---------------------------------;
0636            370   ; ISR for timer 2                 ;
0636            371   ;---------------------------------;
0636            372   Timer2_ISR:
0636 C2CF       373            clr TF2  ; Timer 2 doesn't clear TF2 automatically. Do it in ISR
0638            374            
0638 C0E0       375            push acc
063A C0D0       376            push psw
063C C0F0       377            push b
063E C082       378            push dpl
0640 C083       379            push dph
0642 C000       380            push 0
0644 C001       381            push 1
0646 C002       382            push 2
0648 C003       383            push 3
064A C004       384            push 4
064C C005       385            push 5
064E C006       386            push 6
0650 C007       387            push 7
0652            388            
0652            389            ; Increment the 16-bit one mili second counter
0652 0575       390            inc Count1ms+0    ; Increment the low 8-bits first
0654 E575       391            mov a, Count1ms+0 ; If the low 8-bits overflow, then increment high 8-bits
0656 7002       392            jnz Inc_Done
0658 0576       393            inc Count1ms+1 ;increment high 8-bits if low 8-bits overflowed
065A            394   
065A            395   Inc_Done:
065A            396            ; Check if full second has passed
065A E575       397            mov a, Count1ms+0
065C B4E807     398            cjne a, #low(1000), Timer2_ISR_Midpoint ; Warning: this instruction changes the carry flag!
065F E576       399            mov a, Count1ms+1
0661 B40302     400            cjne a, #high(1000), Timer2_ISR_Midpoint
0664            401   
0664 8003       402       sjmp Timer2_ISR_Bypass
