0000             29   PRESET1_SW     equ SWA_7
0000             30   PRESET2_SW     equ SWA_6
0000             31   PRESET3_SW     equ SWA_5
0000             32   PRESET4_SW     equ SWA_4
0000             33   RED_LED       equ P1_0
0000             34   GREEN_LED     equ P3_1
