0A99           1107   pwm_for_flatstates:
0A99           1108   ; ---- LOW_LIM = max(0, T_TGT - T_BAND)
0A99 E54C      1109           MOV     A, TARGET          
0A9B C3        1110           CLR     C                 ;clear carry
0A9C 9402      1111           SUBB    A, #BAND         ; A = A - BAND
0A9E 5002      1112           JNC     flat_low_ok       
0AA0 7400      1113           MOV     A, #00h           
0AA2           1114   flat_low_ok:
0AA2 F55D      1115           MOV     LOW_LIMIT, A        ; Store low limit in RAM
0AA4           1116   
0AA4           1117           ;compute high limit
0AA4 E54C      1118           MOV     A, TARGET          
0AA6 2402      1119           ADD     A, #BAND         
0AA8 5002      1120           JNC     flat_high_ok      
0AAA 74FF      1121           MOV     A, #0FFh          
0AAC           1122   flat_high_ok:
0AAC F55F      1123           MOV     HIGH_LIMIT, A       
0AAE           1124   
0AAE           1125           ;turn oven on if curren temp is less than low limit
0AAE E53D      1126           MOV     A, TEMP          ;make sure this variables is right!!!!!!!
0AB0 C3        1127           CLR     C               
0AB1 955D      1128           SUBB    A, LOW_LIMIT       
0AB3           1129                                    
0AB3 400A      1130           JC      flat_on       ;temp is less than low limit so turn power on since there is carry
0AB5           1131   
0AB5           1132           ;if current temp is greater than high lim turn off
0AB5 E53D      1133           MOV     A, TEMP
0AB7 C3        1134           CLR     C                 
0AB8 955F      1135           SUBB    A, HIGH_LIMIT       
0ABA           1136                                    
0ABA 6002      1137           JZ      flat_done         ; If equal to HIGH_LIMit do nothing
0ABC 5004      1138           JNC     flat_off      ; If no borrow and not zero T_CUR > HIGH_LIM so turn off
0ABE           1139   
0ABE           1140   flat_done:
0ABE 22        1141           RET                       ; Inside band do nothing, holds prev values
0ABF           1142   flat_on:
0ABF D280      1143           SETB p0.0      ;turn power on
0AC1 22        1144           RET
0AC2           1145   
0AC2           1146   flat_off:
0AC2 C280      1147           CLR p0.0      ;power off
0AC4 22        1148           RET
0AC5           1149   
0AC5           1150   
0AC5           1151   
0AC5           1152   RampBurstPWM:
0AC5           1153   
0AC5           1154           ;increment phase until it equals window then pahse =0
0AC5 E564      1155           MOV     A, PHASE          
0AC7 04        1156           INC     A                 ; A <- A + 1
0AC8 B40602    1157           CJNE    A, #WINDOW, phase_ok  ; if A != WINDOW, keep it
0ACB 7400      1158           MOV     A, #00h           ; else wrap to 0
0ACD           1159   phase_ok:
0ACD F564      1160           MOV     PHASE, A          ; store updated phase 
0ACF           1161   
0ACF           1162           ; calculate threasheld = target - lead
0ACF E54C      1163           MOV     A, TARGET         ; A <- TARGET
0AD1 C3        1164           CLR     C                 
0AD2 9565      1165           SUBB    A, LEAD           
0AD4 5002      1166           JNC     thresh_ok        
0AD6 7400      1167           MOV     A, #00h           
0AD8           1168   thresh_ok:
0AD8 F561      1169           MOV     THRESHOLD, A         
0ADA           1170   
0ADA           1171           ;if temp is less than threshold, full power
0ADA E53D      1172           MOV     A, TEMP           
0ADC C3        1173           CLR     C
0ADD 9561      1174           SUBB    A, THRESHOLD         
0ADF 4010      1175           JC      force_on         
0AE1           1176   
0AE1           1177           ; if temp is greater than target then off
0AE1 E53D      1178           MOV     A, TEMP           
0AE3 C3        1179           CLR     C
0AE4 954C      1180           SUBB    A, TARGET         
0AE6 500C      1181           JNC     force_off         
0AE8           1182   
0AE8           1183           ;else burst pwm 
0AE8           1184           ; CMD_ON = 1 if PHASE < ON_SECS else 0
0AE8 E564      1185           MOV     A, PHASE          ; A <- PHASE (0..WINDOW-1)
0AEA C3        1186           CLR     C
0AEB 9563      1187           SUBB    A, ON_SECS        ; A <- PHASE - ON_SECS
0AED           1188                                    ; borrow => PHASE < ON_SECS
0AED 4008      1189           JC      burst_on          ; if PHASE < ON_SECS => ON
0AEF 8009      1190           SJMP    burst_off         ; else OFF
0AF1           1191   
0AF1           1192   force_on:
0AF1 D280      1193           SETB p0.0      ;less than threshold
0AF3 22        1194           RET
0AF4           1195   
0AF4           1196   force_off:
0AF4 C280      1197           CLR p0.0      
0AF6 22        1198           RET
0AF7           1199   
0AF7           1200   burst_on:
0AF7 D280      1201           SETB p0.0      ; ON for ON_SECS seconds each window
0AF9 22        1202           RET
0AFA           1203   
0AFA           1204   burst_off:
0AFA C280      1205           CLR p0.0      ; OFF for remaining seconds
0AFC 22        1206           RET
