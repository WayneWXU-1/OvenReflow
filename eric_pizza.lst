0559            189   
0559            190   ;-----------------------INTIALIZE SERIAL PORT FOR INPUT OUTUUT-----------------------;
0559            191   ;--Setting baud rate to 57600 with 33.33MHz clock--;
0559            192   ;-----------EXPLANATION------------
0559            193   ;Crystal oscillates at 33.33Mhz, the CV-8052 has a fixed prescaler of 12 for timers
0559            194   ;So the effective clock for timers is 33.33MHz/12 = 2.7775MHzl
0559            195   ;SMOD is set to 1 in PCON so using 1/16th the clock for baud rate generation
0559            196   ;That means the baud rate clock is 2.7775MHz/16 = 173.611kHz
0559            197   ;Since we have 253 out of 256 its three clicks 
0559            198   ;per bit, the baud rate is 173.611kHz/3 = 57.870kbps which is close enough to 57600bps
0559            199   ;-----------------------------------
0559            200   
0559            201   InitSerialPort:
0559            202            ; Configure serial port and baud rate
0559 C28E       203       clr TR1 ; Disable timer 1
055B E589       204       mov a, TMOD
055D 540F       205       anl a, #0x0f ; Clear the bits for timer 1
055F 4420       206       orl a, #0x20 ; Configure timer 1 as 8-bit autoreload
0561 F589       207       mov TMOD, a ; Set timer 1 mode
0563            208   
0563 758DFD     209       mov TH1, #T1_LOAD ; Load the timer value for the desired baud rate
0566 758BFD     210       mov TL1, #T1_LOAD ;Doesnt matter what we load in TL1 because it is in autoreload mode, but we need to load it with something to prevent it from overflowing immediately
0569            211       ;Leave it as you found it, make SMOD = 1 for double baud rate
0569 E587       212       mov a, PCON ; Set SMOD to 1
056B 4480       213       orl a, #0x80
056D F587       214       mov PCON, a
056F D28E       215       setb TR1 ; Enable timer 1
0571 759852     216       mov SCON, #01010010B ; Mode 1, 8-bit UART, enable receiver
0574 22         217            ret
0575            218   
0575            219   Display_Voltage_Serial:
0575 853D68     220            mov x+0, TEMP+0 ; reloads the temp into x which will be converted to bcd
0578 853E69     221       mov x+1, TEMP+1
057B 756A00     222       mov x+2, #0
057E 756B00     223       mov x+3, #0
0581 120267     224       lcall hex2bcd ; standard math32.asm function
0584            225       
0584 7454       226            mov a, #'T'
0586 1205B5     227            lcall putchar
0589 743D       228            mov a, #'='
058B 1205B5     229            lcall putchar
058E            230            
058E E571       231            mov a, bcd+1
0590 540F       232            anl a, #0FH
0592 4430       233            orl a, #'0'
0594 1205B5     234            lcall putchar
0597            235   
0597 E570       236            mov a, bcd+0
0599 C4         237            swap a
059A 540F       238            anl a, #0FH
059C 4430       239            orl a, #'0'
059E 1205B5     240            lcall putchar
05A1            241            
05A1 E570       242            mov a, bcd+0
05A3 540F       243            anl a, #0FH
05A5 4430       244            orl a, #'0'
05A7 1205B5     245            lcall putchar
05AA            246   
05AA 740D       247            mov a, #'\r'
05AC 1205B5     248            lcall putchar
05AF 740A       249            mov a, #'\n'
05B1 1205B5     250            lcall putchar
05B4            251            
05B4 22         252            ret
05B5            253   
05B5            254   
05B5            255   
05B5            256   ; Function to stransmit accumulator value into the serial buffer register after previous completion
05B5            257   putchar:
05B5 3099FD     258       jnb TI, putchar ; TI is the transmit interrupt, it will loop until it is high and we know the previous bit is sent
05B8            259       
05B8 C299       260       clr TI  ; Reset back to 0 to indicate we are transmitting 
05BA F599       261       mov SBUF, a ; accumulator will have output chharacter already stored on it
05BC 22         262       ret
